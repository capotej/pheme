{
    "name": "capotej/pheme",
    "description": "PHP extension that allows embedding of Scheme within PHP applications (using GNU Guile)",
    "type": "php-ext",
    "license": "GPL-3.0-only",
    "require": {
        "php": ">=8.4"
    },
    "php-ext": {
        "extension-name": "pheme",
        "configure-options": [
            {
                "name": "enable-pheme",
                "description": "Enable pheme"
            }
        ]
    }
}
